    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.20",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^14.14.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
