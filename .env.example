# Copy to .env for local development. Never commit .env (it is gitignored).
# Every variable is optional in development; see README "Environment variables".

# HTTP port (Render sets this for you).
PORT=3000

# Public origin used for the Origin check on API/WebSocket requests and cookies.
# Development default: http://localhost:$PORT. Production: your https URL.
APP_ORIGIN=

# SQLite via libSQL. Local file (default) or a Turso database (libsql://...).
DATABASE_URL=file:./data/jm3a.db
# Turso auth token, only for libsql:// URLs.
DATABASE_AUTH_TOKEN=

# Required in production: at least 32 random characters each, e.g. `openssl rand -base64 32`.
# Development: generated once and kept in data/dev-secrets.json.
SESSION_SECRET=
TAG_TOKEN_SECRET=

# Satellite and hybrid map styles (MapTiler free tier). Without it only the street map is offered.
# Read at build time (NEXT_PUBLIC_*): rebuild after changing it.
NEXT_PUBLIC_MAPTILER_KEY=

# Development only: simulated GPS and bot players in "test matches". Ignored in production.
ALLOW_SIM_GPS=false
